{"record_type": "function", "id": "peak_acquisition_mode", "name": "峰值（Peak）获取方式", "description": "该模式下，示波器采集采样间隔内信号的最大值和最小值，以获取信号的包络或可能丢失的窄脉冲；使用该模式可以避免信号的混叠，但显示的噪声比较大；该模式下最小检测脉宽为采样周期。", "data": {"mode": "峰值", "abbr": "Peak", "min_detectable_pulse_width": "采样周期", "effect": "获取包络或可能丢失的窄脉冲", "tradeoff": "避免混叠但噪声较大"}, "source_refs": ["#/texts/977", "#/texts/978", "#/texts/979", "#/texts/980", "#/texts/981", "#/texts/982", "#/texts/983", "#/texts/984", "#/texts/985", "#/texts/986", "#/texts/987", "#/texts/988", "#/texts/989", "#/texts/990", "#/texts/991", "#/texts/992", "#/texts/993", "#/texts/994", "#/texts/995"], "pages": [60], "confidence": 0.9, "verification_status": "llm_extracted", "chapter_id": "chapter_07", "chapter_title": "设置采样系统"}
{"record_type": "function", "id": "ultra_acquisition_mode", "name": "凝时获取（Ultra Acquire）", "description": "凝时模式是快速采集模式的一种，它将示波器内存分成若干等份，每个等份里只存储触发到的单次波形；这种模式下刷新率极大提高，可以最小化触发事件之间的死区时间。", "data": {"mode": "凝时获取", "abbr": "Ultra Acquire", "type": "快速采集模式", "memory_usage": "将内存分成若干等份，每等份只存储触发到的单次波形", "benefit": "刷新率极大提高，最小化触发事件之间的死区时间"}, "source_refs": ["#/texts/977", "#/texts/978", "#/texts/979", "#/texts/980", "#/texts/981", "#/texts/982", "#/texts/983", "#/texts/984", "#/texts/985", "#/texts/986", "#/texts/987", "#/texts/988", "#/texts/989", "#/texts/990", "#/texts/991", "#/texts/992", "#/texts/993", "#/texts/994", "#/texts/995"], "pages": [60], "confidence": 0.9, "verification_status": "llm_extracted", "chapter_id": "chapter_07", "chapter_title": "设置采样系统"}
