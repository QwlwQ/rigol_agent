{"record_type": "relationship", "id": "storage_depth_sample_rate_timebase_relationship", "name": "存储深度、采样率与水平时基档位的关系", "description": "存储深度、采样率与水平时基档位三者的关系满足：MDepth ≥ SRate * TSCale * HDivs，其中HDivs为屏幕水平方向的格数（单位div），TSCale为水平时基档位（单位s/div），SRate为采样率（单位Sa/s），MDepth为存储深度（单位pts）；因此在相同的水平时基档位下，高存储深度可以保证高采样率。", "data": {"formula": "MDepth ≥ SRate * TSCale * HDivs", "variables": {"HDivs": {"description": "屏幕水平方向的格数", "unit": "div"}, "TSCale": {"description": "水平时基档位", "unit": "s/div"}, "SRate": {"description": "采样率", "unit": "Sa/s"}, "MDepth": {"description": "存储深度", "unit": "pts"}}, "implication": "相同水平时基档位下，高存储深度可以保证高采样率"}, "source_refs": ["#/texts/1024", "#/texts/1025", "#/texts/1026", "#/texts/1027", "#/texts/1028", "#/texts/1029", "#/texts/1030", "#/texts/1031", "#/texts/1032", "#/texts/1033", "#/texts/1034", "#/texts/1035", "#/texts/1036", "#/texts/1037", "#/texts/1038", "#/texts/1039", "#/texts/1040", "#/texts/1041", "#/texts/1042", "#/texts/1043", "#/texts/1044", "#/texts/1045", "#/texts/1046", "#/texts/1047", "#/texts/1048"], "pages": [63], "confidence": 0.9, "verification_status": "llm_extracted", "chapter_id": "chapter_07", "chapter_title": "设置采样系统"}
