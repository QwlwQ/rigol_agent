{"record_type": "parameter", "id": "storage_depth_definition", "name": "存储深度", "description": "存储深度是指示波器在一次触发采集中所能存储的波形点数，反映了采集存储器的存储能力；DHO802、DHO804、DHO812和DHO814标配最大25 Mpts存储深度，DHO824标配最大50 Mpts存储深度。", "data": {"definition": "一次触发采集中所能存储的波形点数", "reflects": "采集存储器的存储能力", "max_standard_storage_depth": {"DHO802": "25 Mpts", "DHO804": "25 Mpts", "DHO812": "25 Mpts", "DHO814": "25 Mpts", "DHO824": "50 Mpts"}}, "source_refs": ["#/texts/1016", "#/texts/1017", "#/texts/1018", "#/texts/1019", "#/texts/1020", "#/texts/1021", "#/texts/1022", "#/texts/1023"], "pages": [62], "confidence": 0.9, "verification_status": "llm_extracted", "chapter_id": "chapter_07", "chapter_title": "设置采样系统"}
