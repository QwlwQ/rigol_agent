{"record_type": "parameter", "id": "storage_depth_options_by_channel_mode", "name": "不同通道模式下可选存储深度", "description": "开启任意三个或四个通道（仅适用于四通道型号）时，可选存储深度包括自动、1 kpts、10 kpts、100 kpts、1 Mpts、5 Mpts、10 Mpts（仅DHO824）；开启任意两个通道时，可选存储深度包括自动、1 kpts、10 kpts、100 kpts、1 Mpts、5 Mpts、10 Mpts、25 Mpts（仅DHO824）；只开启任意一个通道时，可选存储深度包括自动、1 kpts、10 kpts、100 kpts、1 Mpts、5 Mpts、10 Mpts、25 Mpts、50 Mpts（仅DHO824）。", "data": {"three_or_four_channels": {"applies_to": "四通道型号", "options": ["自动", "1 kpts", "10 kpts", "100 kpts", "1 Mpts", "5 Mpts", "10 Mpts（仅DHO824）"]}, "two_channels": {"options": ["自动", "1 kpts", "10 kpts", "100 kpts", "1 Mpts", "5 Mpts", "10 Mpts", "25 Mpts（仅DHO824）"]}, "one_channel": {"options": ["自动", "1 kpts", "10 kpts", "100 kpts", "1 Mpts", "5 Mpts", "10 Mpts", "25 Mpts", "50 Mpts（仅DHO824）"]}}, "source_refs": ["#/texts/1024", "#/texts/1025", "#/texts/1026", "#/texts/1027", "#/texts/1028", "#/texts/1029", "#/texts/1030", "#/texts/1031", "#/texts/1032", "#/texts/1033", "#/texts/1034", "#/texts/1035", "#/texts/1036", "#/texts/1037", "#/texts/1038", "#/texts/1039", "#/texts/1040", "#/texts/1041", "#/texts/1042", "#/texts/1043", "#/texts/1044", "#/texts/1045", "#/texts/1046", "#/texts/1047", "#/texts/1048"], "pages": [63], "confidence": 0.9, "verification_status": "llm_extracted", "chapter_id": "chapter_07", "chapter_title": "设置采样系统"}
