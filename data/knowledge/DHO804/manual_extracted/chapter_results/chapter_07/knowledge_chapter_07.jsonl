{"record_type": "operation", "id": "run_stop_sampling", "name": "启动/停止采样", "description": "默认情况下，屏幕上方左侧的运行状态标签为绿色代表实时采样，屏幕右上的STOP/RUN按钮为绿色；点击STOP/RUN按钮或按前面板右侧键可停止采样，此时屏幕上方左侧状态标签变为红色STOP，STOP/RUN按钮变成红色，前面板右侧键红色背光灯点亮；此时示波器保持最后的画面，仍可使用垂直控制和水平控制来平移和缩放波形。", "data": {"running_state_indicator": "绿色实时采样", "stop_actions": ["点击STOP/RUN按钮", "按前面板右侧键"], "stopped_state_indicator": "红色STOP", "stopped_button": "红色", "front_panel_key_backlight": "红色", "stopped_behavior": "保持最后画面，仍可使用垂直控制和水平控制平移和缩放波形"}, "source_refs": ["#/texts/996", "#/texts/997", "#/texts/998", "#/texts/999", "#/texts/1000", "#/texts/1001", "#/texts/1002", "#/texts/1003", "#/texts/1004", "#/texts/1005", "#/texts/1006", "#/texts/1007", "#/texts/1008", "#/texts/1009", "#/texts/1010", "#/texts/1011", "#/texts/1012", "#/texts/1013", "#/texts/1014", "#/texts/1015"], "pages": [61], "confidence": 0.9, "verification_status": "llm_extracted", "chapter_id": "chapter_07", "chapter_title": "设置采样系统"}
